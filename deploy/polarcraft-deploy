#!/usr/bin/env bash

set -Eeuo pipefail

readonly DEPLOY_ROOT='/var/www/polarcraft'
readonly INCOMING="$DEPLOY_ROOT/.deploy-staging/incoming"
readonly ROLLBACK="$DEPLOY_ROOT/.deploy-rollback"
readonly SERVER_DIR="$DEPLOY_ROOT/server"
readonly PM2_PROCESS='polarcraft'
readonly INTERNAL_HEALTH_URL='http://127.0.0.1:3001/api/health'
readonly PUBLIC_BASE_URL='https://polarcraft.fun'

dependencies_changed=false
swap_started=false

fail() {
  printf 'Deployment error: %s\n' "$*" >&2
  return 1
}

wait_for_status() {
  local url=$1
  local expected_status=$2
  local attempts=${3:-15}
  local status

  for ((attempt = 1; attempt <= attempts; attempt += 1)); do
    status=$(curl --silent --show-error --output /dev/null \
      --write-out '%{http_code}' --max-time 10 "$url" || true)
    if [[ "$status" == "$expected_status" ]]; then
      return 0
    fi
    sleep 2
  done

  printf 'Expected HTTP %s from %s, received %s\n' \
    "$expected_status" "$url" "${status:-no response}" >&2
  return 1
}

restore_previous_release() {
  set +e

  if [[ -d "$ROLLBACK/dist" ]]; then
    rm -rf "$DEPLOY_ROOT/dist"
    mv "$ROLLBACK/dist" "$DEPLOY_ROOT/dist"
  fi

  if [[ -d "$ROLLBACK/server/dist" ]]; then
    rm -rf "$SERVER_DIR/dist"
    mv "$ROLLBACK/server/dist" "$SERVER_DIR/dist"
  fi

  if [[ -f "$ROLLBACK/server/package.json" ]]; then
    rm -f "$SERVER_DIR/package.json"
    mv "$ROLLBACK/server/package.json" "$SERVER_DIR/package.json"
  fi

  if [[ -f "$ROLLBACK/server/package-lock.json" ]]; then
    rm -f "$SERVER_DIR/package-lock.json"
    mv "$ROLLBACK/server/package-lock.json" "$SERVER_DIR/package-lock.json"
  fi

  if [[ -d "$ROLLBACK/server/node_modules" ]]; then
    rm -rf "$SERVER_DIR/node_modules"
    mv "$ROLLBACK/server/node_modules" "$SERVER_DIR/node_modules"
  fi

  pm2 restart "$PM2_PROCESS"
  wait_for_status "$INTERNAL_HEALTH_URL" 200 15
}

handle_error() {
  local exit_code=$?

  trap - ERR
  if [[ "$swap_started" == true ]]; then
    printf 'Activation failed; restoring the previous release.\n' >&2
    restore_previous_release
  fi
  exit "$exit_code"
}

handle_signal() {
  local signal=$1
  local exit_code=$2

  trap - ERR HUP INT TERM
  if [[ "$swap_started" == true ]]; then
    printf 'Deployment interrupted by %s; restoring the previous release.\n' \
      "$signal" >&2
    restore_previous_release
  fi
  exit "$exit_code"
}

[[ $EUID -eq 0 ]] || fail 'run this helper through sudo'
command -v curl >/dev/null || fail 'curl is not installed'
command -v flock >/dev/null || fail 'flock is not installed'
command -v pm2 >/dev/null || fail 'pm2 is not installed for root'

exec 9>/var/lock/polarcraft-deploy.lock
flock -n 9 || fail 'another deployment is already running'

[[ -d "$INCOMING/dist" ]] || fail 'frontend staging directory is missing'
[[ -f "$INCOMING/dist/index.html" ]] || fail 'frontend index is missing'
[[ -f "$INCOMING/server/dist/index.js" ]] || fail 'backend entrypoint is missing'
[[ -f "$INCOMING/server/package.json" ]] || fail 'server package.json is missing'
[[ -f "$INCOMING/server/package-lock.json" ]] || fail 'server package-lock.json is missing'
[[ ! -L "$INCOMING/server/package.json" ]] || fail 'server package.json must not be a symbolic link'
[[ ! -L "$INCOMING/server/package-lock.json" ]] \
  || fail 'server package-lock.json must not be a symbolic link'
if [[ ! -f "$DEPLOY_ROOT/.env" && ! -f "$SERVER_DIR/.env" ]]; then
  fail 'backend environment file is missing'
fi
[[ ! -d "$INCOMING/dist/uploads" ]] || fail 'staged uploads are not allowed'
[[ -d "$DEPLOY_ROOT/dist" ]] || fail 'current frontend release is missing'
[[ -d "$SERVER_DIR/dist" ]] || fail 'current backend release is missing'
[[ -d "$SERVER_DIR/node_modules" ]] || fail 'current production dependencies are missing'
[[ -f "$SERVER_DIR/package.json" ]] || fail 'current server package.json is missing'
[[ -f "$SERVER_DIR/package-lock.json" ]] || fail 'current server package-lock.json is missing'

pm2 describe "$PM2_PROCESS" >/dev/null \
  || fail "PM2 process $PM2_PROCESS is unavailable"
wait_for_status "$INTERNAL_HEALTH_URL" 200 3 \
  || fail 'current release is unhealthy; deployment was not started'

if find "$INCOMING/dist" "$INCOMING/server/dist" \
  -type l -print -quit | grep -q .; then
  fail 'symbolic links are not allowed in compiled artifacts'
fi

if ! cmp -s "$INCOMING/server/package.json" "$SERVER_DIR/package.json" \
  || ! cmp -s "$INCOMING/server/package-lock.json" "$SERVER_DIR/package-lock.json"; then
  dependencies_changed=true
  [[ -d "$INCOMING/server/node_modules" ]] \
    || fail 'production dependencies were not installed in staging'
fi

rm -rf "$ROLLBACK"
mkdir -p "$ROLLBACK/server"

trap handle_error ERR
trap 'handle_signal HUP 129' HUP
trap 'handle_signal INT 130' INT
trap 'handle_signal TERM 143' TERM
swap_started=true

pm2 stop "$PM2_PROCESS"
mv "$DEPLOY_ROOT/dist" "$ROLLBACK/dist"
mv "$SERVER_DIR/dist" "$ROLLBACK/server/dist"
mv "$SERVER_DIR/package.json" "$ROLLBACK/server/package.json"
mv "$SERVER_DIR/package-lock.json" "$ROLLBACK/server/package-lock.json"

mv "$INCOMING/dist" "$DEPLOY_ROOT/dist"
mv "$INCOMING/server/dist" "$SERVER_DIR/dist"
mv "$INCOMING/server/package.json" "$SERVER_DIR/package.json"
mv "$INCOMING/server/package-lock.json" "$SERVER_DIR/package-lock.json"

if [[ "$dependencies_changed" == true ]]; then
  mv "$SERVER_DIR/node_modules" "$ROLLBACK/server/node_modules"
  mv "$INCOMING/server/node_modules" "$SERVER_DIR/node_modules"
fi

pm2 restart "$PM2_PROCESS"
wait_for_status "$INTERNAL_HEALTH_URL" 200 20
wait_for_status "$PUBLIC_BASE_URL/" 200 10
wait_for_status "$PUBLIC_BASE_URL/api/health" 200 10
wait_for_status "$PUBLIC_BASE_URL/api/auth/me" 401 10
pm2 describe "$PM2_PROCESS" >/dev/null

trap - ERR HUP INT TERM
rm -rf "$INCOMING"

printf 'Production deployment completed successfully.\n'
