{
  "name": "polariscope",
  "version": "1.0.0",
  "description": "An interactive polarized-light learning and research platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter polariscope-server dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "build:api": "pnpm --filter polariscope-server build",
    "start:api": "pnpm --filter polariscope-server start",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview",
    "test": "vitest",
    "test:api": "pnpm --filter polariscope-server test",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "pnpm --filter polariscope-server typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "framer-motion": "^12.23.25",
    "i18next": "^25.8.0",
    "katex": "^0.16.8",
    "pdfjs-dist": "5.4.296",
    "posthog-js": "^1.361.1",
    "pptx-preview": "^1.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^7.10.1",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.160.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "jsdom": "^27.3.0",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.15"
  }
}
